---
// src/components/blog/BlogPostPage.astro
// 博客详情页共享组件: 通过 slug 与首选语言查找文章并渲染

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Giscus from "@/components/Giscus.astro";
import BlogPostStyles from "@/components/blog/BlogPostStyles.astro";
import { getCollection, render } from "astro:content";
import { getAutoCover } from "@/utils/getAutoCover";
import { SITE_CONFIG } from '@/utils/config';
import type { CollectionEntry } from "astro:content";

interface Props {
  slug: string;
  // 首选语言: 优先查找该语言版本, 找不到再回退到另一语言
  lang?: 'en' | 'zh';
}

const { slug, lang: preferredLang = 'en' } = Astro.props;
const posts: CollectionEntry<"blog">[] = await getCollection("blog");

// 🎯 核心逻辑: 按首选语言优先查找, 找不到再回退到另一语言
const post =
  preferredLang === 'zh'
    ? posts.find((p) => p.id === `zh/${slug}`) || posts.find((p) => p.id === slug)
    : posts.find((p) => p.id === slug) || posts.find((p) => p.id === `zh/${slug}`);
// 消除下面使用 post 时可能 undefined 报错 (实际上永远不会触发)
if (!post) throw new Error(`[FATAL] Post not found for slug: ${slug}`);

const { Content } = await render(post);
const autoCover = getAutoCover(post.body);

// 根据实际渲染的文章判断语言 (可能与首选语言不同, 因为可能回退到另一语言)
const lang = post.id.startsWith("zh/") ? "zh" : "en";
const seoTitle = `${post.data.title} | ${SITE_CONFIG.appName} ${lang === "zh" ? "博客" : "Blog"}`;
const seoDesc =
  post.data.description ||
  (lang === "zh"
    ? `关于 ${SITE_CONFIG.appName} 的最新开发动态和教程。`
    : `The latest development updates and tutorials about ${SITE_CONFIG.appName}.`);
---

<Layout title={seoTitle} lang={lang} description={seoDesc} image={autoCover}>
  <BlogPostStyles />

  <main class="page-wrapper">
    <Header />
    <div class="container">
      <article class="markdown-content blog-post-content">
        <h1>{post.data.title}</h1>
        <p class="meta">
          📅 {
            post.data.pubDate
              ? post.data.pubDate.toLocaleDateString(
                  lang === "zh" ? "zh-CN" : "en-US",
                  { year: "numeric", month: "long", day: "numeric" },
                )
              : ""
          }
        </p>
        <Content />
      </article>
      <Giscus lang={lang} />
    </div>
    <Footer />
  </main>
</Layout>