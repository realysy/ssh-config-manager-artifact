---
/**
 * src/components/Search.astro
 * 基于 Pagefind 的无服务搜索弹窗组件, 支持快捷键 Ctrl+K / Cmd+K 唤起
 */
import { getLangFromPath } from '@/utils/i18n';

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';

const currentPath = Astro.url.pathname;
const isZh = getLangFromPath(currentPath, baseUrl) === 'zh';
---

<!-- 搜索触发按钮 -->
<button 
  type="button" 
  class="icon-button search-trigger" 
  id="search-trigger"
  data-tooltip={isZh ? "搜索 (Ctrl+K)" : "Search (Ctrl+K)"}
  aria-label={isZh ? "搜索" : "Search"}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
</button>

<!-- 搜索弹窗 -->
<div id="search-modal" class="search-modal" style="display: none;">
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-content">
    <div id="search-ui"></div>
  </div>
</div>

<!-- 🌟 使用 is:inline 确保脚本不被 Astro 打包处理 -->
<script is:inline>
  (function() {
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const backdrop = modal.querySelector('.search-modal-backdrop');
    let pagefindUI = null;
    let loaded = false;

    // 从 meta 标签读取 base URL, 完美兼容 GitHub Pages 子路径
    const baseUrl = document.querySelector('meta[name="base-url"]')?.content || '/';

    function openSearch() {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      
      // 🌟 懒加载: 首次打开时才加载 Pagefind JS 引擎
      if (!loaded) {
        const script = document.createElement('script');
        script.src = `${baseUrl}pagefind/pagefind-ui.js`;
        script.onload = function() {
          const PagefindUI = window.PagefindUI;
          pagefindUI = new PagefindUI({
            element: document.getElementById('search-ui'),
            showSubResults: true,
            showImages: false,
            resetStyles: false,
            bundlePath: `${baseUrl}pagefind/`,
            translations: {
              placeholder: document.documentElement.lang === 'zh' ? '搜索文档和博客...' : 'Search docs and blog...',
              zero_results: document.documentElement.lang === 'zh' ? '未找到相关结果' : 'No results found',
              searching: document.documentElement.lang === 'zh' ? '搜索中...' : 'Searching...',
            }
          });

          // 🌟 核心优化: 监听 DOM 变化, 实现点击"加载更多"后自动平滑滚动到新结果
          const resultsArea = document.querySelector('.pagefind-ui__results-area');
          if (resultsArea) {
            const observer = new MutationObserver((mutations) => {
              for (const mutation of mutations) {
                // 当检测到子节点发生变化 (即 Pagefind 插入了新的结果)
                if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                  // 过滤出新增的 .pagefind-ui__result 节点
                  const newResults = Array.from(mutation.addedNodes).filter(
                    node => node.nodeType === 1 && node.classList.contains('pagefind-ui__result')
                  );
                  if (newResults.length > 0) {
                    // 将第一批新结果平滑滚动到可视区域边缘
                    newResults[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  }
                }
              }
            });
            // 仅监听子节点的增删
            observer.observe(resultsArea, { childList: true });
          }

          // 自动聚焦输入框
          setTimeout(() => {
            const input = document.querySelector('.pagefind-ui__search-input');
            if (input) input.focus();
          }, 100);
          loaded = true;
        };
        document.body.appendChild(script);
      } else {
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }
    }

    function closeSearch() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    trigger?.addEventListener('click', openSearch);
    backdrop?.addEventListener('click', closeSearch);

    // 全局快捷键监听
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.style.display === 'flex') {
        closeSearch();
      }
      // Ctrl+K / Cmd+K 唤起搜索
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.style.display === 'flex') {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });
  })();
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }

  .search-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: relative;
    width: 90%;
    max-width: 70vh;
    max-height: 80vh;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: auto;
    padding: 20px;
  }

  /* 🌟 Pagefind UI 样式覆盖 (通过 CSS 变量) */
  .search-modal-content :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: #0969da;
    --pagefind-ui-text: #1f2328;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d7de;
    --pagefind-ui-tag: #f6f8fa;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* 暗黑模式适配 */
  [data-theme="dark"] .search-modal-content {
    background: #161b22;
    border: 1px solid #30363d;
  }

  [data-theme="dark"] .search-modal-content :global(.pagefind-ui) {
    --pagefind-ui-primary: #58a6ff;
    --pagefind-ui-text: #e6edf3;
    --pagefind-ui-background: #161b22;
    --pagefind-ui-border: #30363d;
    --pagefind-ui-tag: #21262d;
  }
</style>