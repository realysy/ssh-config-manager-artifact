---
// 接收当前页面的语言属性
const { lang = 'zh' } = Astro.props;
// Giscus 语言映射, 'zh-CN' 对应中文, 'en' 对应英文
const giscusLang = lang === 'zh' ? 'zh-CN' : 'en';
---

<!-- 评论区容器 -->
<div class="giscus-wrapper" style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #d0d7de;">
  <h2 style="margin-bottom: 16px; font-size: 1.2em; color: #667eea;">💬 {lang === 'zh' ? '评论' : 'Comments'}</h2>
  
  <!-- 🌟 核心优化: 使用占位符 + IntersectionObserver 懒加载 Giscus, 避免国内网络阻塞页面加载指示器 -->
  <div class="giscus-placeholder" id="giscus-placeholder" data-lang={giscusLang}></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const placeholder = document.getElementById('giscus-placeholder');
    if (!placeholder) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // 动态创建 Giscus script
          const script = document.createElement('script');
          script.src = 'https://giscus.app/client.js';
          script.setAttribute('data-repo', 'realysy/ssh-config-manager-artifact');
          script.setAttribute('data-repo-id', 'R_kgDOSXpgUg');
          script.setAttribute('data-category', 'Announcements');
          script.setAttribute('data-category-id', 'DIC_kwDOSXpgUs4C_yNi');
          script.setAttribute('data-mapping', 'pathname');
          script.setAttribute('data-strict', '1');
          script.setAttribute('data-reactions-enabled', '1');
          script.setAttribute('data-emit-metadata', '0');
          script.setAttribute('data-input-position', 'bottom');
          script.setAttribute('data-theme', 'light');
          // 从占位符的 data 属性中读取语言
          script.setAttribute('data-lang', placeholder.dataset.lang || 'en');
          script.setAttribute('crossorigin', 'anonymous');
          script.async = true;
          
          placeholder.appendChild(script);
          observer.disconnect(); // 注入后停止监听，防止重复加载
        }
      });
    }, { rootMargin: '200px' }); // 提前 200px 开始加载，保证滚动时的无缝体验

    observer.observe(placeholder);
  });
</script>

<style>
  /* 确保 Giscus iframe 自适应宽度 */
  .giscus-wrapper :global(.giscus-frame) {
    width: 100%;
    border: none;
  }
</style>