<!-- src/components/MarkdownStyles.astro -->
<!-- 共享的 Markdown 内容样式: 供博客详情页与文档详情页复用 -->
<style is:global>
  /* 🌟 全局统一设置代码元素的跨平台等宽字体栈 */
  code, pre, kbd, samp {
    font-family: "Cascadia Code", "Fira Code", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  /* 🎨 视觉调整: 恢复 H2 左侧的科技蓝竖条, 保持现代克制 */
  .markdown-content h2 {
    font-size: 1.5em;
    margin: 40px 0 16px;
    padding: 0 0 8px 16px;
    border-bottom: 1px solid #d0d7de;
    border-left: 4px solid #0969da;
    color: #1f2328;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .markdown-content h3 {
    font-size: 1.25em;
    margin: 24px 0 16px;
    color: #1f2328;
    font-weight: 600;
  }

  .markdown-content h4 {
    font-size: 1.1em;
    margin: 20px 0 12px;
    font-weight: 600;
  }

  /* 移除渐变背景, 改为极简的 Callout 提示框 */
  .feature-box {
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    color: #1f2328;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 24px;
  }

  .feature-box p {
    color: #1f2328;
    margin-bottom: 8px;
  }

  .terminal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .terminal-badge {
    background: #ffffff;
    border: 1px solid #d0d7de;
    padding: 4px 10px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 500;
    color: #1f2328;
  }

  .info-box {
    background: #ddf4ff;
    border: 1px solid #54aeff;
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 24px;
  }

  .info-box p {
    margin-bottom: 8px;
    color: #0969da;
  }

  .code-block,
  .markdown-content pre {
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 16px;
    overflow-x: auto;
    font-size: 14px;
    color: #1f2328;
  }

  .markdown-content pre code {
    background: none;
    padding: 0;
    font-size: 14px;
  }

  .markdown-content code {
    background: rgba(175, 184, 193, 0.2);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 85%;
    color: #0550ae;
  }

  /* Markdown 列表样式 */
  .markdown-content ul,
  .markdown-content ol {
    padding-left: 2em;
    margin-bottom: 16px;
  }

  .markdown-content ul ul,
  .markdown-content ol ol,
  .markdown-content ul ol,
  .markdown-content ol ul {
    margin-bottom: 0;
  }

  .markdown-content li {
    margin-bottom: 6px;
  }

  .markdown-content li>p {
    margin-bottom: 6px;
  }

  /* Markdown 正文图片响应式优化 */
  .markdown-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 24px 0;
    border: 1px solid #d0d7de;
    display: block;
  }

  /* Markdown 表格样式 */
  .markdown-content table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 16px;
    display: block;
    overflow-x: auto;
  }

  .markdown-content th,
  .markdown-content td {
    border: 1px solid #d0d7de;
    padding: 8px 12px;
    text-align: left;
  }

  .markdown-content th {
    background: #f6f8fa;
    font-weight: 600;
  }

  /* ========== 暗色模式适配 ========== */
  [data-theme="dark"] .markdown-content h1,
  [data-theme="dark"] .markdown-content h2,
  [data-theme="dark"] .markdown-content h3,
  [data-theme="dark"] .markdown-content h4 {
    color: #e6edf3;
  }

  [data-theme="dark"] .markdown-content h1,
  [data-theme="dark"] .markdown-content h2 {
    border-bottom-color: #30363d;
    border-left-color: #2f81f7; /* 暗黑模式下的科技蓝竖条 */
  }

  [data-theme="dark"] .code-block,
  [data-theme="dark"] .markdown-content pre,
  [data-theme="dark"] .markdown-content th,
  [data-theme="dark"] .feature-box,
  [data-theme="dark"] .terminal-badge {
    background: #161b22;
    border-color: #30363d;
    color: #e6edf3;
  }

  [data-theme="dark"] .markdown-content code {
    background: rgba(110, 118, 129, 0.2);
    color: #79c0ff;
  }

  [data-theme="dark"] .markdown-content tr:nth-child(even) {
    background-color: #161b22;
  }

  [data-theme="dark"] .markdown-content th,
  [data-theme="dark"] .markdown-content td {
    border-color: #30363d;
  }

  [data-theme="dark"] .info-box {
    background: rgba(56, 139, 253, 0.1);
    border-color: rgba(56, 139, 253, 0.4);
  }

  [data-theme="dark"] .info-box p {
    color: #58a6ff;
  }
</style>