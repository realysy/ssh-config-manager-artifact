---
// src/components/PricingCards.astro
import { getLangFromPath } from '@/utils/i18n';

// 🌟 1. 直接从 src/assets 导入二维码图片
// Astro 会自动处理它们的路径、base 前缀以及添加 hash
import qrItch from '@/assets/qrcode_itch_io.png';
import qrTaobao from '@/assets/qrcode_taobao.png';

// 🛡️ 防呆处理: 确保 baseUrl 永远以斜杠结尾 (仅用于处理其它可能的静态文本链接)
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';

const currentPath = Astro.url.pathname;
const isZh = getLangFromPath(currentPath, baseUrl) === 'zh';
---

<div class="channels-grid">
  <!-- itch.io 渠道卡片 -->
  <div class="channel-card">
    <div class="channel-header">
      <span class="channel-icon">🌍</span>
      <span class="channel-name">{isZh ? '海外用户 (itch.io)' : 'Global Users (itch.io)'}</span>
    </div>
    <div class="channel-content">
      <div class="channel-left">
        <!-- 🌟 2. 使用 .src 属性渲染图片, Astro 会自动注入正确的完整 URL -->
        <img src={qrItch.src} alt={isZh ? 'itch.io 购买二维码' : 'itch.io QR Code'} class="qr-code" loading="lazy">
        <div class="channel-price" id="price-itch">$28.9</div>
      </div>

      <div class="channel-info">
        <h3 class="channel-title">SSH Config Manager</h3>
        <p class="channel-author">by realysy</p>
        <div class="payment-methods">
          <span class="method-label">{isZh ? '支持:' : 'Supports:'}</span>
          <span class="method-tag">PayPal</span>
          <span class="method-tag">{isZh ? '信用卡' : 'Credit Card'}</span>
          <span class="method-tag">{isZh ? '借记卡' : 'Debit Card'}</span>
        </div>
        <div class="payment-highlight-note">✨ {isZh ? '无需注册账号, 凭邮箱即可购买.' : 'No account registration required, purchase with email.'}</div>
        <div class="payment-highlight-note">✨ {isZh ? '支付成功后, itch.io 会自动发放 download key 作为激活码.' : 'After payment, itch.io automatically issues a download key as the activation code.'}</div>
        <a href="https://realysy.itch.io/ssh-config-manager" target="_blank" rel="noopener noreferrer" class="buy-btn itch-buy-btn">
          🛒 {isZh ? '前往 itch.io 购买' : 'Buy on itch.io'}
        </a>
      </div>
    </div>

    <!-- 🌟 添加错误提示占位符, 默认隐藏 -->
    <p class="channel-note" id="note-itch" style="display: none;"></p>
  </div>

  <!-- 淘宝渠道卡片 -->
  <div class="channel-card">
    <div class="channel-header">
      <span class="channel-icon">🇨🇳</span>
      <span class="channel-name">{isZh ? '中国大陆用户 (淘宝)' : 'Mainland China Users (Taobao)'}</span>
    </div>
    <div class="channel-content">
      <div class="channel-left">
        <img src={qrTaobao.src} alt={isZh ? '淘宝购买二维码' : 'Taobao QR Code'} class="qr-code" loading="lazy">
        <div class="channel-price" id="price-tb">¥88</div>
      </div>

      <div class="channel-info">
        <h3 class="channel-title">SSH Config Manager</h3>
        <p class="channel-author">{isZh ? '购买力平价 (PPP) 折扣' : 'Purchasing Power Parity (PPP) Discount'}</p>
        <div class="payment-methods">
          <span class="method-label">{isZh ? '支持:' : 'Supports:'}</span>
          <span class="method-tag">{isZh ? '支付宝' : 'Alipay'}</span>
          <span class="method-tag">{isZh ? '微信支付' : 'WeChat Pay'}</span>
          <span class="method-tag">{isZh ? '花呗' : 'Huabei'}</span>
          <span class="method-tag">{isZh ? '银行卡' : 'Bank Card'}</span>
        </div>
        <div class="payment-highlight-note">📱 {isZh ? '需使用淘宝/支付宝账号登录购买.' : 'Requires Taobao/Alipay account to purchase.'}</div>
        <div class="payment-highlight-note">📱 {isZh ? '支付成功后, 请联系卖家客服获取激活码.' : 'After payment, please contact the seller\'s customer service to get the activation code.'}</div>
        <a href="https://item.taobao.com/item.htm?ft=t&id=1055953631461" target="_blank" rel="noopener noreferrer" class="buy-btn taobao-buy-btn">
          🛒 {isZh ? '前往淘宝购买' : 'Buy on Taobao'}
        </a>
      </div>
    </div>

    <!-- 🌟 添加错误提示占位符, 默认隐藏 -->
    <p class="channel-note" id="note-tb" style="display: none;"></p>
  </div>

  <!-- Creem 渠道卡片 -->
  <div class="channel-card">
    <div class="channel-header">
      <span class="channel-icon">💳</span>
      <span class="channel-name">{isZh ? '国际用户 (Creem)' : 'International Users (Creem)'}</span>
    </div>
    <div class="channel-content">
      <div class="channel-left">
        <!-- 🌟 使用 Creem 官方 SVG 作为占位图/Logo, 保持与二维码相同的尺寸和圆角 -->
        <div class="qr-code creem-logo-placeholder">
          <svg width="60" height="60" viewBox="0 0 121 121" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.1102 11C24.1187 11 25.9669 12.0982 26.9281 13.8619L51.2059 58.4106C52.5699 60.9134 55.7048 61.8368 58.2077 60.473C60.7108 59.109 61.6342 55.9742 60.2701 53.4712L41.5466 19.113C39.554 15.4566 42.2004 11 46.3645 11H103.806C107.885 11 110.539 15.2933 108.715 18.9416L65.0579 106.254C63.0356 110.298 57.2654 110.298 55.2431 106.254L11.5863 18.9416C9.76212 15.2933 12.4156 11 16.4946 11H22.1102Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="channel-price" id="price-creem">$30.4</div>
      </div>

      <div class="channel-info">
        <h3 class="channel-title">SSH Config Manager</h3>
        <p class="channel-author">by realysy</p>
        <div class="payment-methods">
          <span class="method-label">{isZh ? '支持:' : 'Supports:'}</span>
          <span class="method-tag">{isZh ? '信用卡' : 'Credit Card'}</span>
          <span class="method-tag">{isZh ? '借记卡' : 'Debit Card'}</span>
          <span class="method-tag">PayPal</span>
          <span class="method-tag">Apple Pay</span>
          <span class="method-tag">Google Pay</span>
        </div>
        <div class="payment-highlight-note">✨ {isZh ? '安全快捷的国际支付网关, 支持多种本地支付方式.' : 'Secure and fast international payment gateway, supports various local payment methods.'}</div>
        <div class="payment-highlight-note">✨ {isZh ? '支付成功后, 激活码将自动发送至您的邮箱.' : 'After payment, the activation code will be automatically sent to your email.'}</div>
        
        <!-- 🌟 Creem 购买按钮容器, 包含浅色和深色两个按钮, 通过 CSS 控制暗黑模式切换 -->
        <div class="creem-btn-container">
          <!-- 浅色主题按钮 (默认显示) -->
          <a href="https://www.creem.io/payment/prod_7PRk3MakptaCRPG2p6ahW5" data-creem-checkout data-creem-theme="light" class="creem-buy-btn creem-btn-light">
            <svg width="15" height="15" viewBox="0 0 121 121" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M22.1102 11C24.1187 11 25.9669 12.0982 26.9281 13.8619L51.2059 58.4106C52.5699 60.9134 55.7048 61.8368 58.2077 60.473C60.7108 59.109 61.6342 55.9742 60.2701 53.4712L41.5466 19.113C39.554 15.4566 42.2004 11 46.3645 11H103.806C107.885 11 110.539 15.2933 108.715 18.9416L65.0579 106.254C63.0356 110.298 57.2654 110.298 55.2431 106.254L11.5863 18.9416C9.76212 15.2933 12.4156 11 16.4946 11H22.1102Z" fill="#151617"/>
            </svg>
            <span>{isZh ? '使用 Creem 购买' : 'Buy with Creem'}</span>
          </a>
          <!-- 深色主题按钮 (暗黑模式下显示) -->
          <a href="https://www.creem.io/payment/prod_7PRk3MakptaCRPG2p6ahW5" data-creem-checkout data-creem-theme="dark" class="creem-buy-btn creem-btn-dark">
            <svg width="15" height="15" viewBox="0 0 121 121" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M22.1102 11C24.1187 11 25.9669 12.0982 26.9281 13.8619L51.2059 58.4106C52.5699 60.9134 55.7048 61.8368 58.2077 60.473C60.7108 59.109 61.6342 55.9742 60.2701 53.4712L41.5466 19.113C39.554 15.4566 42.2004 11 46.3645 11H103.806C107.885 11 110.539 15.2933 108.715 18.9416L65.0579 106.254C63.0356 110.298 57.2654 110.298 55.2431 106.254L11.5863 18.9416C9.76212 15.2933 12.4156 11 16.4946 11H22.1102Z" fill="#151617"/>
            </svg>
            <span>{isZh ? '使用 Creem 购买' : 'Buy with Creem'}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 🌟 添加错误提示占位符, 默认隐藏 -->
    <p class="channel-note" id="note-creem" style="display: none;"></p>
  </div>
</div>

<style>
  /* ========== 购买渠道卡片样式 ========== */
  
  /* 🌟 核心修复：重置被外层 .markdown-content 污染的全局 margin */
  /* 因为组件被放在 .markdown-content 内，全局的 img, h3, p 会带入巨大的 margin，必须强制清零 */
  .channel-card img,
  .channel-card h3,
  .channel-card p {
    margin: 0;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
    margin-bottom: 20px;
  }

  .channel-card {
    background: #fafafa;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 20px;
    transition: all 0.3s;
  }

  .channel-card:hover {
    border-color: #0969da;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
    transform: translateY(-2px);
  }

  .channel-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #edf2f7;
  }

  .channel-icon { font-size: 24px; }
  .channel-name { font-size: 16px; font-weight: 600; color: #333; }

  .channel-content {
    display: flex;
    flex-direction: row; 
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .channel-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .channel-price {
    font-size: 22px;
    font-weight: 700;
    color: #e53e3e;
    margin: 0;
  }

  .qr-code {
    width: 120px;
    height: 120px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* Creem Logo 占位符基础样式 */
  .creem-logo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7fafc;
    color: #2d3748;
  }

  /* ========== Creem 购买按钮样式 ========== */
  .creem-btn-container {
    margin-top: 10px;
    display: flex;
    gap: 10px;
  }

  .creem-buy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 12px;
    border: 2px solid #151617;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .creem-buy-btn:hover {
    transform: translateY(-2px);
    box-shadow: 4px 4px 0 0 #151617;
    text-decoration: none;
  }

  .creem-buy-btn svg {
    display: block;
    flex: 0 0 auto;
  }

  /* 浅色按钮 (默认显示) */
  .creem-btn-light {
    background: #FFBE98;
    color: #151617;
    box-shadow: 3px 3px 0 0 #151617;
  }

  /* 深色按钮 (默认隐藏) */
  .creem-btn-dark {
    background: #FFBE98;
    color: #151617;
    box-shadow: 3px 3px 0 0 #000000;
    display: none; 
  }
  
  .creem-btn-dark:hover {
    box-shadow: 4px 4px 0 0 #000000;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .channel-title { font-size: 16px; font-weight: 600; color: #333; margin: 0; }
  .channel-author { font-size: 13px; color: #718096; margin: 0; }

  .payment-methods {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .method-label { font-size: 12px; color: #718096; margin-right: 2px; }
  
  .method-tag {
    display: inline-block;
    font-size: 11px;
    background: #e2e8f0;
    color: #4a5568;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }

  .payment-highlight-note {
    display: block;
    width: fit-content;
    font-size: 12px;
    color: #718096;
    border-radius: 4px;
  }

  .buy-btn {
    display: inline-block;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 20px;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s;
    margin-top: 10px;
    width: fit-content;
    border: none;
    cursor: pointer;
  }

  .itch-buy-btn { background: #fa5c5c; color: white; }
  .itch-buy-btn:hover { background: #e04b4b; color: white; transform: translateY(-1px); text-decoration: none; }

  .taobao-buy-btn { background: linear-gradient(90deg, #ff4400, #ff6a00); color: white; }
  .taobao-buy-btn:hover { background: linear-gradient(90deg, #e63e00, #e65c00); color: white; transform: translateY(-1px); text-decoration: none; }

  .channel-note {
    font-size: 12px;
    color: #e53e3e;
    text-align: center;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px dashed #e2e8f0;
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* 🌟 移动端紧凑布局优化 (扩大断点至 640px，覆盖绝大多数手机和窄屏窗口) */
  @media (max-width: 640px) {
    .channel-card {
      padding: 16px;
    }
    
    .channel-header {
      margin-bottom: 12px;
      padding-bottom: 8px;
    }
    
    .channel-content {
      flex-direction: column;
      text-align: center;
      gap: 12px;
    }
    
    .channel-left {
      gap: 6px;
    }
    
    .qr-code {
      width: 100px;
      height: 100px;
    }
    
    .channel-price {
      font-size: 20px;
    }
    
    .channel-info { 
      align-items: center; 
      gap: 4px;
    }
    
    .payment-methods {
      justify-content: center;
      margin-top: 2px;
      margin-bottom: 4px;
    }
    
    .payment-highlight-note {
      font-size: 11px;
    }
    
    .buy-btn {
      margin-top: 8px;
      width: 100%;
      max-width: 240px;
    }
  }

  /* 暗黑模式适配 (使用 :global 确保生效) */
  :global([data-theme="dark"]) .channel-card { background: #161b22; border-color: #30363d; }
  :global([data-theme="dark"]) .channel-header { border-bottom-color: #30363d; }
  :global([data-theme="dark"]) .channel-name,
  :global([data-theme="dark"]) .channel-title { color: #e2e8f0; }
  :global([data-theme="dark"]) .channel-author,
  :global([data-theme="dark"]) .method-label,
  :global([data-theme="dark"]) .payment-highlight-note { color: #a0aec0; }
  :global([data-theme="dark"]) .method-tag { background: #30363d; color: #e2e8f0; }
  :global([data-theme="dark"]) .qr-code { border-color: #30363d; }
  :global([data-theme="dark"]) .channel-note { 
    border-top-color: #30363d; 
    color: #f85149;
  }
  /* 🌟 Creem Logo 占位符暗黑模式适配 */
  :global([data-theme="dark"]) .creem-logo-placeholder {
    background: #2d3748;
    color: #e2e8f0;
  }
  /* 🌟 暗黑模式下切换按钮显示状态 */
  :global([data-theme="dark"]) .creem-btn-light {
    display: none;
  }
  :global([data-theme="dark"]) .creem-btn-dark {
    display: inline-flex;
  }
</style>


<script>
  // 🌟 1. 定义 JSON 数据的 TypeScript 接口
  interface PriceInfo {
    price: number | string;
    currency: string;
  }

  interface PriceData {
    itch?: PriceInfo;
    tb?: PriceInfo;
    creem?: PriceInfo;
  }

  // 🌍 根据当前 HTML lang 属性判断语言, 决定错误提示文本
  const isZh = document.documentElement.lang === 'zh';
  const errorMsg = isZh 
    ? '⚠️ 获取最新售价失败, 请扫描二维码或点击购买按钮前往购买页面查看最新价格.' 
    : '⚠️ Failed to fetch latest prices. Please scan the QR code or click the buy button to check the latest price on the store page.';

  const noteItch = document.getElementById('note-itch');
  const noteTb = document.getElementById('note-tb');
  const noteCreem = document.getElementById('note-creem');

  // 🌟 2. 为 data 参数添加类型注解, 修复隐式 any 报错
  function updatePriceFromData(data: PriceData): boolean {
    let success = false;
    
    // 🌟 3. 提前获取 DOM 元素, 并使用 if 判空修复 'Object is possibly null' 报错
    const priceItchEl = document.getElementById('price-itch');
    const priceTbEl = document.getElementById('price-tb');
    const priceCreemEl = document.getElementById('price-creem');

    // 更新 itch.io 价格
    if (data.itch && typeof data.itch.price !== 'undefined') {
      const symbol = data.itch.currency === 'USD' ? '$' : (data.itch.currency + ' ');
      if (priceItchEl) priceItchEl.textContent = symbol + data.itch.price;
      success = true;
    } else if (noteItch) {
      noteItch.textContent = errorMsg;
      noteItch.style.display = 'block';
    }
    
    // 更新淘宝价格
    if (data.tb && typeof data.tb.price !== 'undefined') {
      const symbol = data.tb.currency === 'CNY' ? '¥' : (data.tb.currency + ' ');
      if (priceTbEl) priceTbEl.textContent = symbol + data.tb.price;
      success = true;
    } else if (noteTb) {
      noteTb.textContent = errorMsg;
      noteTb.style.display = 'block';
    }

    // 更新 Creem 价格
    if (data.creem && typeof data.creem.price !== 'undefined') {
      const symbol = data.creem.currency === 'USD' ? '$' : (data.creem.currency + ' ');
      if (priceCreemEl) priceCreemEl.textContent = symbol + data.creem.price;
      success = true;
    } else if (noteCreem) {
      noteCreem.textContent = errorMsg;
      noteCreem.style.display = 'block';
    }
    
    return success;
  }

  // 🌟 4. 为 url 添加 string 注解, 为返回值添加 Promise<PriceData> 注解
  async function tryFetchFromUrl(url: string): Promise<PriceData> {
    const resp = await fetch(`${url}?t=${Date.now()}`, { cache: 'no-store' });
    if (!resp.ok) throw new Error('Network response was not ok');
    // 使用 as PriceData 进行类型断言
    return await resp.json() as PriceData; 
  }

  async function fetchPrices(): Promise<void> {
    // 🌟 动态构建主 URL, 完美兼容 Astro 的 site 和 base 配置 (如 GitHub Pages 子路径)
    const site = import.meta.env.SITE || window.location.origin;
    const base = import.meta.env.BASE_URL || '/';
    
    // 🛠️ 核心修复: 确保 base 以斜杠结尾, 防止与文件名直接粘连 (如 .../artifactprices.json)
    const normalizedBase = base.endsWith('/') ? base : `${base}/`;
    
    // 拼接并清理可能出现的双斜杠 (排除 http:// 或 https:// 中的斜杠)
    const primaryUrl = `${site}${normalizedBase}prices.json`.replace(/([^:]\/)\/+/g, "$1"); 
    
    // 🛡️ 兜底: GitHub Raw 链接 (确保即使官网 CDN 出问题也能获取到价格)
    const fallbackUrl = 'https://raw.githubusercontent.com/realysy/ssh-config-manager-artifact/main/public/prices.json';

    try {
      // 1. 先尝试主 URL
      const data = await tryFetchFromUrl(primaryUrl);
      updatePriceFromData(data);
    } catch (e1) {
      console.warn('Primary price URL failed, trying fallback:', e1);
      try {
        // 2. 主 URL 失败, 尝试 GitHub 备用 URL
        const data = await tryFetchFromUrl(fallbackUrl);
        updatePriceFromData(data);
      } catch (e2) {
        console.warn('Fallback price URL also failed, showing error tips:', e2);
        // 3. 两个 URL 都失败, 显示错误提示
        if (noteItch) { noteItch.textContent = errorMsg; noteItch.style.display = 'block'; }
        if (noteTb) { noteTb.textContent = errorMsg; noteTb.style.display = 'block'; }
        if (noteCreem) { noteCreem.textContent = errorMsg; noteCreem.style.display = 'block'; }
      }
    }
  }

  // 页面加载完成后执行
  fetchPrices();
</script>

