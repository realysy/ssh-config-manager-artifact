<!-- src/components/docs/DocStyles.astro -->
<style is:global>
  /* 3-column layout */
  .doc-layout {
    display: grid;
    grid-template-columns: 240px 1fr 200px;
    gap: 40px;
    align-items: start;
  }

  .doc-main-title {
    font-size: 2em;
    margin-bottom: 32px;
    border-bottom: 2px solid #0969da;
    padding-bottom: 12px;
    color: #1f2328;
  }

  /* 🌟 文档首页设置为垂直目录列表布局 */
  .doc-index-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .doc-category-section h2 {
    font-size: 1.25em;
    margin-top: 0;
    border: none;
    padding: 0 0 8px 0;
    margin-bottom: 12px;
    color: #1f2328;
    font-weight: 600;
  }

  .doc-category-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .doc-category-section li {
    margin-bottom: 0; /* 移除原有的 8px, 改为由 a 标签的 padding 控制间距 */
  }

  .doc-category-section a {
    display: block;
    padding: 8px 12px;
    border-radius: 6px;
    /* 保留原有的科技蓝 */
    color: #0969da;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .doc-category-section a:hover {
    /* 🌟 修改: hover 时增加浅灰背景, 移除下划线, 提升目录交互感 */
    background: #f6f8fa;
    color: #0550ae;
    text-decoration: none; 
  }

  /* Sidebar */
  .doc-sidebar {
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding-right: 16px;
  }

  .sidebar-title {
    font-size: 1.1em;
    margin-bottom: 16px;
    color: #1f2328;
  }

  .sidebar-group {
    margin-bottom: 24px;
  }

  .sidebar-category {
    font-size: 0.9em;
    text-transform: uppercase;
    color: #656d76;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .doc-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .doc-sidebar li {
    margin-bottom: 4px;
  }

  .doc-sidebar a {
    display: block;
    padding: 6px 12px;
    border-radius: 6px;
    color: #1f2328;
    text-decoration: none;
    font-size: 14px;
    transition: background 0.15s;
  }

  .doc-sidebar a:hover {
    background: #f3f4f6;
    color: #0969da;
  }

  .doc-sidebar a.active {
    background: #ddf4ff;
    color: #0969da;
    font-weight: 600;
  }

  /* TOC */
  .doc-toc {
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding-left: 16px;
    border-left: 1px solid #d0d7de;
  }

  .toc-title {
    font-size: 0.9em;
    text-transform: uppercase;
    color: #656d76;
    margin-bottom: 12px;
    letter-spacing: 0.05em;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 8px;
  }

  .toc-item a {
    color: #656d76;
    text-decoration: none;
    font-size: 13px;
    line-height: 1.4;
    display: block;
  }

  .toc-item a:hover {
    color: #0969da;
  }

  .toc-item.depth-3 {
    padding-left: 12px;
  }

  .toc-item.depth-4 {
    padding-left: 24px;
  }

  /* Prev/Next */
  .doc-prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid #d0d7de;
  }

  .doc-nav-card {
    padding: 16px;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .doc-nav-card:hover {
    border-color: #0969da;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.1);
    text-decoration: none;
  }

  .doc-nav-card.next {
    text-align: right;
  }

  .nav-label {
    display: block;
    font-size: 12px;
    color: #656d76;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .nav-title {
    color: #0969da;
    font-weight: 600;
    font-size: 15px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .doc-layout {
      grid-template-columns: 200px 1fr;
    }
    .doc-toc {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .doc-layout {
      grid-template-columns: 1fr;
    }
    .doc-sidebar {
      position: relative;
      top: 0;
      max-height: none;
      border-bottom: 1px solid #d0d7de;
      padding-bottom: 24px;
      margin-bottom: 24px;
      padding-right: 0;
    }
    .doc-prev-next {
      grid-template-columns: 1fr;
    }
  }

  /* Dark mode */
  [data-theme="dark"] .doc-category-section h2 {
    /* 暗黑模式下标题改为正文色 */
    color: #e6edf3;
  }

  [data-theme="dark"] .doc-category-section a {
    /* 暗黑模式下链接改为科技蓝 */
    color: #58a6ff;
  }

  /* 暗黑模式下链接的 hover 状态 */
  [data-theme="dark"] .doc-category-section a:hover {
    background: #161b22;
    color: #79c0ff;
  }

  [data-theme="dark"] .doc-sidebar a.active {
    background: rgba(56, 139, 253, 0.15);
    color: #58a6ff;
  }

  [data-theme="dark"] .doc-toc {
    border-left-color: #30363d;
  }

  [data-theme="dark"] .toc-item a {
    color: #8b949e;
  }

  [data-theme="dark"] .toc-item a:hover {
    color: #58a6ff;
  }

  [data-theme="dark"] .doc-prev-next {
    border-top-color: #30363d;
  }

  [data-theme="dark"] .doc-nav-card {
    border-color: #30363d;
    background: #161b22;
  }

  [data-theme="dark"] .doc-nav-card:hover {
    border-color: #58a6ff;
    box-shadow: 0 4px 12px rgba(88, 166, 255, 0.1);
  }

  [data-theme="dark"] .nav-label {
    color: #8b949e;
  }

  [data-theme="dark"] .nav-title {
    color: #58a6ff;
  }
</style>