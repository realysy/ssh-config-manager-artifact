---
/**
 * src/components/docs/DocSidebar.astro
 * 文档左侧导航栏: 支持多层级树形渲染
 */
import { getCollection } from 'astro:content';
import { buildDocTree } from '@/utils/docTree';
import SidebarNode from './SidebarNode.astro';

interface Props {
  lang: 'en' | 'zh';
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const allDocs = await getCollection('docs');

// 🌟 核心修复: 区分 Collection 前缀和 URL 前缀
const collectionPrefix = lang === 'zh' ? 'zh/' : 'en/';
const urlPrefix = lang === 'zh' ? 'zh/' : ''; // 英文 URL 不带 en/

const docs = allDocs.filter(doc => doc.id.startsWith(collectionPrefix));
const treeRoots = buildDocTree(docs, collectionPrefix);

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith("/")) baseUrl += "/";
---

<nav class="doc-sidebar">
  <h3 class="sidebar-title">{lang === 'zh' ? '文档目录' : 'Documentation'}</h3>
  <ul class="sidebar-tree">
    {treeRoots.map(root => (
      <SidebarNode 
        node={root} 
        currentSlug={currentSlug} 
        baseUrl={baseUrl} 
        urlPrefix={urlPrefix} 
      />
    ))}
  </ul>
</nav>