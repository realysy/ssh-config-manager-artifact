---
// src/pages/doc/index.astro
// 英文文档首页: 显示所有文档目录分类

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DocStyles from "@/components/docs/DocStyles.astro";
import { getCollection } from "astro:content";
import { SITE_CONFIG } from '@/utils/config';

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith("/")) baseUrl += "/";

const allDocs = (await getCollection("docs")).filter(d => d.id.startsWith("en/"));

// 🌟 核心逻辑: 分离分类配置和普通文档
const categoryMeta = allDocs.filter(d => d.data.category === true);
const regularDocs = allDocs.filter(d => d.data.category !== true);

const groupedDocs = regularDocs.reduce((acc, doc) => {
  const cleanPath = doc.id.replace(/^en\//, '').replace(/\.mdx?$/, '');
  const parts = cleanPath.split("/");
  const categorySlug = parts.length > 1 ? parts[0] : "general";
  
  if (!acc[categorySlug]) {
    acc[categorySlug] = { title: categorySlug.replace(/-/g, ' '), order: 999, docs: [] };
  }
  acc[categorySlug].docs.push({ ...doc, cleanPath });
  return acc;
}, {} as Record<string, any>);

categoryMeta.forEach(meta => {
  const metaPath = meta.id.replace(/^en\//, '').replace(/\.mdx?$/, '');
  const categorySlug = metaPath.split('/')[0]; 
  if (groupedDocs[categorySlug]) {
    groupedDocs[categorySlug].title = meta.data.title;
    if (meta.data.order !== undefined) groupedDocs[categorySlug].order = meta.data.order;
  }
});

const sortedCategories = Object.entries(groupedDocs).sort((a, b) => (a[1].order ?? 999) - (b[1].order ?? 999));
sortedCategories.forEach(([_, cat]) => {
  cat.docs.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
});
---

<Layout title={`Documentation - ${SITE_CONFIG.appName}`} lang="en">
  <DocStyles />
  <div class="page-wrapper">
    <Header />
    <div class="container">
      <h1 class="doc-main-title">📚 Documentation</h1>
      <div class="doc-index-grid">
        {sortedCategories.map(([slug, cat]) => (
          <div class="doc-category-card">
            <h2>{cat.title}</h2>
            <ul>
              {cat.docs.map(doc => (
                <li>
                  <a href={`${baseUrl}doc/${doc.cleanPath}/`}>
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <Footer />
  </div>
</Layout>