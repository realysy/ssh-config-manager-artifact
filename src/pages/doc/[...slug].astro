---
// src/pages/doc/[...slug].astro (中文版同理，替换 en/ 为 zh/)
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DocSidebar from "@/components/docs/DocSidebar.astro";
import DocTOC from "@/components/docs/DocTOC.astro";
import DocPrevNext from "@/components/docs/DocPrevNext.astro";
import DocStyles from "@/components/docs/DocStyles.astro";
import { getCollection, render } from "astro:content";
import { SITE_CONFIG } from '@/utils/config';
import { buildDocTree, flattenDocTree } from "@/utils/docTree";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter(doc => doc.id.startsWith("en/") && doc.data.category !== true) 
    .map(doc => ({
      params: { slug: doc.id.replace(/^en\//, '').replace(/\.mdx?$/, '') },
      props: { doc },
    }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const slug = doc.id.replace(/^en\//, '').replace(/\.mdx?$/, '');

// 🌟 核心重构: 构建树并展平，确保 Prev/Next 能完美跨越文件夹边界
const allDocs = (await getCollection("docs")).filter(d => d.id.startsWith("en/"));
const tree = buildDocTree(allDocs, 'en/');
const flatDocs = flattenDocTree(tree);

const currentIndex = flatDocs.findIndex(d => d.slug === slug);
const prevDoc = currentIndex > 0 ? flatDocs[currentIndex - 1] : null;
const nextDoc = currentIndex < flatDocs.length - 1 ? flatDocs[currentIndex + 1] : null;

const seoTitle = `${doc.data.title} | ${SITE_CONFIG.appName} Docs`;
---

<Layout title={seoTitle} lang="en" description={doc.data.description}>
  <DocStyles />
  <!-- 🌟 修改: 增加 doc-page class 触发宽屏自适应布局 -->
  <div class="page-wrapper doc-page">
    <Header />
    <div class="container doc-layout">
      <DocSidebar lang="en" currentSlug={slug} />
      <main class="doc-content markdown-content">
        <h1>{doc.data.title}</h1>
        <Content />
        <DocPrevNext 
          lang="en"
          prev={prevDoc ? { title: prevDoc.title, slug: prevDoc.slug } : null}
          next={nextDoc ? { title: nextDoc.title, slug: nextDoc.slug } : null}
        />
      </main>
      <DocTOC headings={headings} lang="en" />
    </div>
    <Footer />
  </div>
</Layout>