---
// src/pages/doc/[...slug].astro
// 英文文档详情页面: 渲染逻辑统一封装在 DocPostPage 组件

import DocPostPage from "@/components/docs/DocPostPage.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter(doc => doc.id.startsWith("en/") && doc.data.category !== true)
    .map(doc => {
      const slug = doc.id.replace(/^en\//, '').replace(/\.mdx?$/, '');
      return {
        params: { slug },
        props: { doc, slug },
      };
    });
}

const { doc, slug } = Astro.props;
---

<DocPostPage lang="en" doc={doc} slug={slug} />