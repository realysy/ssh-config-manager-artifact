---
// src/pages/zh/doc/[...slug].astro
// 中文文档详情页面: 复用 DocPostPage 组件

import DocPostPage from "@/components/docs/DocPostPage.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter(doc => doc.id.startsWith("zh/") && doc.data.category !== true)
    .map(doc => {
      const slug = doc.id.replace(/^zh\//, '').replace(/\.mdx?$/, '');
      return {
        params: { slug },
        props: { doc, slug },
      };
    });
}

const { doc, slug } = Astro.props;
---

<DocPostPage lang="zh" doc={doc} slug={slug} />