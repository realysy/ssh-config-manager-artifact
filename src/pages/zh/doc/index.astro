---
// src/pages/doc/index.astro
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DocStyles from "@/components/docs/DocStyles.astro";
import { getCollection } from "astro:content";
import { SITE_CONFIG } from '@/utils/config';
import { buildDocTree } from "@/utils/docTree";

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith("/")) baseUrl += "/";

const allDocs = (await getCollection("docs")).filter(d => d.id.startsWith("zh/"));
const roots = buildDocTree(allDocs, 'zh/');
---

<Layout title={`Documentation - ${SITE_CONFIG.appName}`} lang="zh">
  <DocStyles />
  <div class="page-wrapper">
    <Header />
    <div class="container">
      <h1 class="doc-main-title">📚 Documentation</h1>
      <div class="doc-index-list">
        {roots.map(root => (
          <div class="doc-category-section">
            <h2>{root.title}</h2>
            <ul>
              {root.children.map(child => (
                <li>
                  {child.type === 'file' ? (
                    <a href={`${baseUrl}doc/${child.slug}/`}>{child.title}</a>
                  ) : (
                    <!-- 渲染子文件夹及其内部的文档 -->
                    <div class="sub-folder">
                      <div class="sub-folder-title">{child.title}</div>
                      <ul class="sub-folder-list">
                        {child.children.map(sub => (
                          <li>
                            <a href={`${baseUrl}doc/${sub.slug}/`}>{sub.title}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <Footer />
  </div>
</Layout>