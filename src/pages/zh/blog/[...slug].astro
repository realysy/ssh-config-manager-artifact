---
// src/pages/zh/blog/[...slug].astro
// 中文博客详情页面: 复用 BlogPostPage 组件

import BlogPostPage from "@/components/blog/BlogPostPage.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts: CollectionEntry<"blog">[] = await getCollection("blog");
  // 提取所有去重后的核心 Slug, 为每种语言生成完整的路由
  const coreSlugs = new Set<string>();
  for (const post of posts) {
    const coreSlug = post.id.startsWith("zh/")
      ? post.id.replace(/^zh\//, "")
      : post.id;
    coreSlugs.add(coreSlug);
  }
  return Array.from(coreSlugs).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<BlogPostPage slug={slug!} lang="zh" />